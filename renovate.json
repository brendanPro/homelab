{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 9am on monday"],
  "labels": ["renovate"],
  "kubernetes": {
    "fileMatch": [
      "apps/.+/base/.+/deploy\\.yaml$",
      "apps/.+/base/.+/deployment\\.yaml$",
      "apps/.+/resources/.+\\.yaml$",
      "platform/.+/base/.+/deploy\\.yaml$"
    ]
  },
  "kustomize": {
    "fileMatch": [
      "(^|/)kustomization\\.yaml$"
    ]
  },
  "packageRules": [
    {
      "description": "Apps critiques — mise à jour manuelle, PR uniquement",
      "matchPackageNames": [
        "ghcr.io/home-assistant/home-assistant",
        "docker.io/vaultwarden/server",
        "koenkk/zigbee2mqtt",
        "ghcr.io/blakeblackshear/frigate",
        "eclipse-mosquitto"
      ],
      "automerge": false,
      "labels": ["renovate", "critical"]
    },
    {
      "description": "Tailscale operator Helm chart — PR uniquement, review manuelle",
      "matchPackageNames": ["tailscale-operator"],
      "matchManagers": ["kustomize"],
      "automerge": false,
      "labels": ["renovate", "infra", "tailscale"]
    },
    {
      "description": "Infra réseau et stockage — ignorer (trop sensible, mise à jour manuelle)",
      "matchPackageNames": [
        "docker.io/calico/cni",
        "docker.io/calico/node",
        "docker.io/calico/kube-controllers",
        "registry.k8s.io/metrics-server/metrics-server",
        "quay.io/ceph/ceph",
        "rook/ceph"
      ],
      "enabled": false
    }
  ]
}

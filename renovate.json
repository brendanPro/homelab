{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 9am on monday"],
  "labels": ["renovate"],
  "kubernetes": {
    "fileMatch": [
      "apps/.+/base/.+/deploy\\.yaml$",
      "apps/.+/base/.+/depoly\\.yaml$",
      "apps/.+/base/deploy\\.yaml$",
      "apps/.+/resources/deploy\\.yaml$",
      "apps/.+/resources/depoly\\.yaml$",
      "platform/.+/base/.+\\.yaml$"
    ]
  },
  "kustomize": {
    "fileMatch": ["(^|/)kustomization\\.yaml$"]
  },
  "packageRules": [
    {
      "description": "Apps avec données / impact prod — PR manuelle obligatoire",
      "matchManagers": ["kustomize", "kubernetes"],
      "matchPackageNames": [
        "ghcr.io/home-assistant/home-assistant",
        "docker.io/vaultwarden/server",
        "vaultwarden/server",
        "koenkk/zigbee2mqtt",
        "ghcr.io/blakeblackshear/frigate",
        "eclipse-mosquitto"
      ],
      "automerge": false,
      "labels": ["renovate", "critical"]
    },
    {
      "description": "Apps stateless — PR sans auto-merge",
      "matchManagers": ["kustomize", "kubernetes"],
      "matchPackageNames": [
        "ghcr.io/gethomepage/homepage"
      ],
      "automerge": false,
      "labels": ["renovate"]
    },
    {
      "description": "Platform — PR manuelle",
      "matchManagers": ["kustomize", "kubernetes"],
      "matchPackageNames": [
        "tailscale-operator",
        "registry.k8s.io/metrics-server/metrics-server",
        "alpine"
      ],
      "automerge": false,
      "labels": ["renovate", "infra"]
    },
    {
      "description": "CNI Calico — ignorer (mise à jour manuelle cluster-wide)",
      "matchPackageNames": [
        "docker.io/calico/cni",
        "docker.io/calico/node",
        "docker.io/calico/kube-controllers"
      ],
      "enabled": false
    },
    {
      "description": "Legacy Ceph/Rook — ignoré",
      "matchPackageNames": ["quay.io/ceph/ceph", "rook/ceph"],
      "enabled": false
    }
  ]
}

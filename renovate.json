{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 9am on monday"],
  "labels": ["renovate"],
  "kubernetes": {
    "managerFilePatterns": [
      "/apps/.+/base/.+/deploy\\.yaml$/",
      "/apps/.+/base/.+/depoly\\.yaml$/",
      "/apps/.+/base/deploy\\.yaml$/",
      "/apps/.+/base/deploy-.+\\.yaml$/",
      "/apps/.+/resources/deploy\\.yaml$/",
      "/apps/.+/resources/depoly\\.yaml$/",
      "/platform/.+/base/.+\\.yaml$/"
    ]
  },
  "kustomize": {
    "managerFilePatterns": [
      "/(^|/)kustomization\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "ArgoCD install.yaml remote resource version",
      "managerFilePatterns": [
        "/platform/argocd/base/kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "https://raw\\.githubusercontent\\.com/argoproj/argo-cd/(?<currentValue>v\\d+\\.\\d+\\.\\d+)/manifests/install\\.yaml"
      ],
      "depNameTemplate": "argoproj/argo-cd",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Apps avec données / impact prod — PR manuelle obligatoire",
      "matchManagers": ["kustomize", "kubernetes"],
      "matchPackageNames": [
        "ghcr.io/home-assistant/home-assistant",
        "docker.io/vaultwarden/server",
        "vaultwarden/server",
        "koenkk/zigbee2mqtt",
        "ghcr.io/blakeblackshear/frigate",
        "eclipse-mosquitto",
        "ghcr.io/immich-app/immich-server",
        "ghcr.io/immich-app/immich-machine-learning",
        "ghcr.io/immich-app/postgres",
        "docker.io/valkey/valkey",
        "valkey/valkey"
      ],
      "automerge": false,
      "labels": ["renovate", "critical"]
    },
    {
      "description": "Apps stateless — PR sans auto-merge",
      "matchManagers": ["kustomize", "kubernetes"],
      "matchPackageNames": [
        "ghcr.io/gethomepage/homepage",
        "ghcr.io/umami-software/umami"
      ],
      "automerge": false,
      "labels": ["renovate"]
    },
    {
      "description": "Platform — PR manuelle",
      "matchManagers": ["kustomize", "kubernetes", "custom.regex"],
      "matchPackageNames": [
        "tailscale-operator",
        "registry.k8s.io/metrics-server/metrics-server",
        "alpine",
        "argoproj/argo-cd",
        "viaductoss/ksops"
      ],
      "automerge": false,
      "labels": ["renovate", "infra"]
    },
    {
      "description": "CNI Calico — ignorer (mise à jour manuelle cluster-wide)",
      "matchPackageNames": [
        "docker.io/calico/cni",
        "docker.io/calico/node",
        "docker.io/calico/kube-controllers"
      ],
      "enabled": false
    },
    {
      "description": "Legacy Ceph/Rook — ignoré",
      "matchPackageNames": ["quay.io/ceph/ceph", "rook/ceph"],
      "enabled": false
    },
    {
      "description": "OpenEBS — hors GitOps images (install manuelle)",
      "matchPackageNames": [
        "openebs/provisioner-localpv",
        "openebs/node-disk-manager",
        "openebs/node-disk-operator",
        "openebs/node-disk-exporter"
      ],
      "enabled": false
    }
  ]
}

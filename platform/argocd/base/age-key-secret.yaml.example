# Secret bootstrap ArgoCD — NE PAS COMMITTER avec une vraie clé
#
# Créer sur le cluster :
#   kubectl create secret generic argocd-age-key \
#     -n platform \
#     --from-file=keys.txt=$HOME/.config/sops/age/keys.txt
#
# Voir secrets/README.md pour le workflow complet.
apiVersion: v1
kind: Secret
metadata:
  name: argocd-age-key
  namespace: platform
type: Opaque
stringData:
  keys.txt: |
    # AGE-SECRET-KEY-1...

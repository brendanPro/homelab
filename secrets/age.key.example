# Clé privée age — NE PAS COMMITTER
#
# SOPS utilise par défaut la clé standard :
#   ~/.config/sops/age/keys.txt
#
# Pour ArgoCD sur le cluster, créer le secret depuis ce fichier :
#   kubectl create secret generic argocd-age-key \
#     -n platform \
#     --from-file=keys.txt=$HOME/.config/sops/age/keys.txt
#
# Optionnel : copier ou symlink vers secrets/age.key si tu préfères un chemin local :
#   ln -sf ~/.config/sops/age/keys.txt secrets/age.key
